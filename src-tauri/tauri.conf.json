{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PortReaper",
  "version": "0.1.0",
  "identifier": "dev.amitgal.portreaper",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "PortReaper",
        "width": 760,
        "height": 540,
        "minWidth": 560,
        "minHeight": 380,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Kill ports. See what is behind them.",
    "longDescription": "PortReaper shows every listening port on your Mac, which project and branch it belongs to, and kills it in one click.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "portreaper",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "check": "biome check . && vue-tsc --noEmit && vitest run",
    "check:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "check:all": "pnpm check && pnpm check:rust",
    "icons": "node scripts/render-icons.mjs",
    "e2e": "playwright test --project webkit --project chromium",
    "e2e:ui": "playwright test --ui",
    "screenshot": "playwright test --project screenshot"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.7.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-global-shortcut": "^2.4.0",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "lucide-vue-next": "^1.0.0",
    "reka-ui": "^2.11.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@resvg/resvg-js": "^2.6.2",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.5"
  },
  "description": "See every listening port on your Mac, which project it belongs to, and kill it in one click.",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  }
}
